import pygame

pygame.init()

# Create screen
screen = pygame.display.set_mode((500, 400))
pygame.display.set_caption("Simple Sprite Example")

# Custom event
CHANGE_COLOR = pygame.USEREVENT + 1

# Sprite 1
sprite1 = pygame.Surface((100, 100))
sprite1.fill((255, 0, 0))  # red
rect1 = sprite1.get_rect(topleft=(100, 150))

# Sprite 2
sprite2 = pygame.Surface((100, 100))
sprite2.fill((0, 0, 255))  # blue
rect2 = sprite2.get_rect(topleft=(300, 150))

running = True
while running:
    for event in pygame.event.get():
        if event.type == pygame.QUIT:
            running = False

        # When SPACE is pressed, create custom event
        if event.type == pygame.KEYDOWN:
            if event.key == pygame.K_SPACE:
                pygame.event.post(pygame.event.Event(CHANGE_COLOR))

        # When custom event happens, change colours
        if event.type == CHANGE_COLOR:
            sprite1.fill((0, 255, 0))   # green
            sprite2.fill((255, 255, 0)) # yellow

    screen.fill((200, 200, 200))
    screen.blit(sprite1, rect1)
    screen.blit(sprite2, rect2)
    pygame.display.update()

pygame.quit()